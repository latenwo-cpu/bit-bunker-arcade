rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Game-end ad media (videos / images) uploaded from admin.html.
    // Anyone can view them (the arcade needs to play them), but only a
    // signed-in admin can upload or delete, and uploads are capped at 50 MB
    // and must be an image or a video.
    match /ad-media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
